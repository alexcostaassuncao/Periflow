{
  "name": "TimeRecord",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in_time": {
      "type": "string",
      "format": "time"
    },
    "check_in_photo": {
      "type": "string"
    },
    "check_out_time": {
      "type": "string",
      "format": "time"
    },
    "check_out_photo": {
      "type": "string"
    },
    "total_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "checked_in",
        "completed",
        "absent"
      ],
      "default": "checked_in"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_email",
    "date"
  ]
}