{
  "name": "ImportRecord",
  "type": "object",
  "properties": {
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "xlsx",
        "csv"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "imported_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que importou"
    },
    "imported_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "processando",
        "concluido",
        "erro"
      ],
      "default": "aguardando"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "total_records": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "description": "Registros importados (atividades/tarefas)",
      "items": {
        "type": "object",
        "properties": {
          "cliente": {
            "type": "string"
          },
          "squad": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "tipo_tarefa": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "prazo": {
            "type": "string"
          },
          "data_conclusao": {
            "type": "string"
          },
          "pendencias": {
            "type": "string"
          },
          "mes_referencia": {
            "type": "string"
          }
        }
      }
    },
    "mes_referencia": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia (YYYY-MM)"
    }
  },
  "required": [
    "file_name",
    "file_type",
    "imported_by"
  ]
}