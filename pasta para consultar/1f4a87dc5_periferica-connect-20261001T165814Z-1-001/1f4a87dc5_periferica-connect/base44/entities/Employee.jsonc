{
  "name": "Employee",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "department": {
      "type": "string",
      "enum": [
        "social_media",
        "design",
        "trafego",
        "atendimento",
        "gestao"
      ],
      "description": "Setor do funcion\u00e1rio"
    },
    "carteira": {
      "type": "string",
      "enum": [
        "c1",
        "c2",
        "c3",
        "c4",
        "gerencia",
        "videomaker",
        "comercial"
      ],
      "description": "Carteira/Squad ao qual o funcion\u00e1rio pertence"
    },
    "position": {
      "type": "string",
      "description": "Cargo do funcion\u00e1rio"
    },
    "phone": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "clt",
        "pj",
        "estagio",
        "freelancer"
      ]
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento (DDMMAAAA)"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "employee_status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    },
    "xp_total": {
      "type": "number",
      "default": 0
    },
    "current_level": {
      "type": "number",
      "default": 1
    },
    "accumulated_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos acumulados para folga"
    },
    "bonus_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo de b\u00f4nus monet\u00e1rio em reais"
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0,
      "description": "Dias consecutivos com tarefas conclu\u00eddas"
    },
    "theme_prefs": {
      "type": "object",
      "description": "Prefer\u00eancias visuais individuais do usu\u00e1rio",
      "properties": {
        "themeKey": {
          "type": "string"
        },
        "primaryColor": {
          "type": "string"
        },
        "bgMode": {
          "type": "string"
        },
        "bgType": {
          "type": "string"
        },
        "bgImage": {
          "type": "string"
        },
        "buttonStyle": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id",
    "department",
    "position"
  ]
}