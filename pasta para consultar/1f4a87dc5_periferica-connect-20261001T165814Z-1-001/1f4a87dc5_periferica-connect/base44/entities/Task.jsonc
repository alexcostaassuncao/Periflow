{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "a_fazer",
        "em_andamento",
        "em_revisao",
        "aguardando_aprovacao",
        "concluida"
      ],
      "default": "a_fazer"
    },
    "responsible_email": {
      "type": "string"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails dos colaboradores"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "description": "Etapas/eventos da tarefa",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "executor_email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ],
            "default": "pending"
          },
          "uses_timer": {
            "type": "boolean"
          },
          "time_spent": {
            "type": "number"
          },
          "form_data": {
            "type": "object"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "current_event_index": {
      "type": "number",
      "default": 0
    },
    "ajustes": {
      "type": "array",
      "description": "Hist\u00f3rico de ajustes solicitados",
      "items": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          }
        }
      }
    },
    "xp_reward": {
      "type": "number",
      "default": 0,
      "description": "XP s\u00f3 concedido quando TODOS formul\u00e1rios da tarefa forem conclu\u00eddos"
    },
    "xp_concedido": {
      "type": "boolean",
      "default": false,
      "description": "Se o XP j\u00e1 foi concedido ao finalizar todos os formul\u00e1rios"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_time_spent": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "responsible_email",
    "due_date",
    "priority"
  ]
}