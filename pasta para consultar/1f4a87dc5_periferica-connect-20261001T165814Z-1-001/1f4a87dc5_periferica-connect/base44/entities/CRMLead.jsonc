{
  "name": "CRMLead",
  "type": "object",
  "properties": {
    "nome_contato": {
      "type": "string",
      "description": "Nome do contato/prospect"
    },
    "telefone": {
      "type": "string"
    },
    "nome_empresa": {
      "type": "string"
    },
    "segmento": {
      "type": "string",
      "description": "Ramo/segmento de atua\u00e7\u00e3o"
    },
    "email": {
      "type": "string"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es (m\u00e1x 500 caracteres)"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospeccao",
        "reuniao_marcada",
        "contrato",
        "onboarding",
        "cliente_ativo",
        "cancelado"
      ],
      "default": "prospeccao"
    },
    "motivo_cancelamento": {
      "type": "string",
      "enum": [
        "sem_retorno",
        "valor_alto",
        "fechou_concorrente",
        "desistiu",
        "cancelado",
        "outro"
      ],
      "description": "Motivo do encerramento/cancelamento"
    },
    "observacoes_cancelamento": {
      "type": "string"
    },
    "data_reuniao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da reuni\u00e3o"
    },
    "observacoes_reuniao": {
      "type": "string"
    },
    "responsavel_email": {
      "type": "string",
      "description": "Email do respons\u00e1vel comercial"
    },
    "responsavel_nome": {
      "type": "string"
    },
    "mes_referencia": {
      "type": "string",
      "description": "YYYY-MM \u2014 m\u00eas em que o lead foi criado"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "ID do evento no CalendarEvent vinculado \u00e0 reuni\u00e3o"
    },
    "dados_contrato": {
      "type": "object",
      "description": "Dados do contrato gerado",
      "properties": {
        "razao_social": {
          "type": "string"
        },
        "cpf_cnpj": {
          "type": "string"
        },
        "telefone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "endereco": {
          "type": "string"
        },
        "responsavel": {
          "type": "string"
        },
        "data_entrada": {
          "type": "string"
        },
        "data_encerramento": {
          "type": "string"
        },
        "valor_entrada": {
          "type": "number"
        },
        "valor_mensal": {
          "type": "number"
        },
        "modelo_contrato": {
          "type": "string"
        }
      }
    },
    "checklist_onboarding": {
      "type": "object",
      "description": "Checklist de onboarding",
      "properties": {
        "acesso_recebido": {
          "type": "boolean",
          "default": false
        },
        "briefing_recebido": {
          "type": "boolean",
          "default": false
        },
        "grupo_criado": {
          "type": "boolean",
          "default": false
        },
        "contrato_assinado": {
          "type": "boolean",
          "default": false
        },
        "pagamento_recebido": {
          "type": "boolean",
          "default": false
        },
        "squad_definido": {
          "type": "boolean",
          "default": false
        },
        "inicio_projeto": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "historico": {
      "type": "array",
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_email": {
            "type": "string"
          },
          "usuario_nome": {
            "type": "string"
          },
          "status_anterior": {
            "type": "string"
          },
          "status_novo": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "nome_contato",
    "telefone",
    "nome_empresa"
  ]
}