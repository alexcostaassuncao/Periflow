{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "task_link"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails mencionados"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "group_id",
    "sender_email",
    "content"
  ]
}