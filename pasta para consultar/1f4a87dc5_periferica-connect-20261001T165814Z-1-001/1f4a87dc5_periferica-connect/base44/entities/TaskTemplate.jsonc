{
  "name": "TaskTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "criacao",
        "revisao",
        "aprovacao",
        "planejamento",
        "reuniao",
        "outros"
      ]
    },
    "default_priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ]
    },
    "default_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "default_events": {
      "type": "array",
      "description": "Etapas padr\u00e3o do template",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "duration_days": {
            "type": "number"
          },
          "estimated_time": {
            "type": "number"
          },
          "uses_timer": {
            "type": "boolean"
          }
        }
      }
    },
    "form_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "select",
              "date",
              "number",
              "file",
              "checkbox"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "default_xp": {
      "type": "number",
      "default": 50
    }
  },
  "required": [
    "name",
    "task_type"
  ]
}