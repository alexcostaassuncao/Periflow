{
  "name": "ClienteSquad",
  "type": "object",
  "properties": {
    "workspace_nome": {
      "type": "string",
      "description": "Nome do workspace exatamente como aparece no CSV (uppercase, trimado)"
    },
    "squad_nome": {
      "type": "string",
      "description": "Nome da carteira/squad (ex: Carteira C1)"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "planejamento_recorrente",
        "campanha",
        "cancelamento",
        "outro"
      ],
      "default": "planejamento_recorrente"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "workspace_nome",
    "squad_nome"
  ]
}