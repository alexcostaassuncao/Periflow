{
  "name": "EkyteWorkspace",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "description": "Nome do workspace/cliente exatamente como vem no CSV (trimado e uppercase)"
    },
    "mes_referencia": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "novas": {
      "type": "number",
      "default": 0
    },
    "concluidas": {
      "type": "number",
      "default": 0
    },
    "atrasaram": {
      "type": "number",
      "default": 0
    },
    "esforco": {
      "type": "string"
    },
    "qtd_pecas": {
      "type": "number",
      "default": 0
    },
    "qtd_formularios": {
      "type": "number",
      "default": 0
    },
    "qtd_publicacoes": {
      "type": "number",
      "default": 0
    },
    "novos_tickets": {
      "type": "number",
      "default": 0
    },
    "concluidos_tickets": {
      "type": "number",
      "default": 0
    },
    "ultima_atualizacao_arquivo": {
      "type": "string"
    },
    "chave_unica": {
      "type": "string",
      "description": "workspace|mes_referencia"
    }
  },
  "required": [
    "workspace",
    "mes_referencia",
    "chave_unica"
  ]
}