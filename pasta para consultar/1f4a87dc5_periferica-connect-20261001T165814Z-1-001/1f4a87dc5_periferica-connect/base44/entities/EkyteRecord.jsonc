{
  "name": "EkyteRecord",
  "type": "object",
  "properties": {
    "chave_unica": {
      "type": "string",
      "description": "Chave composta para deduplica\u00e7\u00e3o: cliente|tipo_tarefa|responsavel|squad"
    },
    "cliente": {
      "type": "string"
    },
    "squad": {
      "type": "string"
    },
    "responsavel": {
      "type": "string"
    },
    "tipo_tarefa": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "prazo": {
      "type": "string"
    },
    "data_conclusao": {
      "type": "string"
    },
    "pendencias": {
      "type": "string"
    },
    "mes_referencia": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "projeto": {
      "type": "string"
    },
    "id_ekyte": {
      "type": "string",
      "description": "ID original da tarefa no eKyte, se dispon\u00edvel"
    },
    "ultima_atualizacao_arquivo": {
      "type": "string",
      "description": "Nome do \u00faltimo arquivo que atualizou este registro"
    }
  },
  "required": [
    "chave_unica",
    "cliente",
    "status"
  ]
}