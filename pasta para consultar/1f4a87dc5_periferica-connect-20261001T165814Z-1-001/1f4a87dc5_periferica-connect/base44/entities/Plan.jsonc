{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plano"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "social_media",
        "trafego",
        "completo",
        "design",
        "video"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de recursos inclu\u00eddos"
    },
    "deliverables": {
      "type": "object",
      "properties": {
        "posts": {
          "type": "number"
        },
        "stories": {
          "type": "number"
        },
        "reels": {
          "type": "number"
        },
        "design_pieces": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}