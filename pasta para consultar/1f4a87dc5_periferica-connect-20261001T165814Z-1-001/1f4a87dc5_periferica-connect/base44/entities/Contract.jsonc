{
  "name": "Contract",
  "type": "object",
  "properties": {
    "contract_number": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string",
      "description": "Or\u00e7amento que originou o contrato"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_cpf_cnpj": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "services": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o dos servi\u00e7os contratados"
    },
    "monthly_value": {
      "type": "number"
    },
    "contract_duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em meses"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "transferencia",
        "cartao"
      ]
    },
    "payment_day": {
      "type": "number",
      "description": "Dia do vencimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "suspenso",
        "cancelado",
        "finalizado"
      ],
      "default": "ativo"
    },
    "signed_document_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "monthly_value",
    "start_date"
  ]
}