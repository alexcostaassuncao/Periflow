{
  "name": "ChatGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do grupo (ex: C1 - Carteira Christina)"
    },
    "type": {
      "type": "string",
      "enum": [
        "carteira",
        "squad",
        "projeto"
      ],
      "description": "Tipo do grupo"
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails dos membros do grupo"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do gestor respons\u00e1vel"
    },
    "avatar_color": {
      "type": "string",
      "default": "#ff5000"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "arquivado"
      ],
      "default": "ativo"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "type",
    "owner_email"
  ]
}