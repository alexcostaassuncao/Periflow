{
  "name": "EquipamentoImport",
  "type": "object",
  "properties": {
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "xlsx",
        "csv"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "imported_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que importou"
    },
    "imported_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "processando",
        "concluido",
        "erro"
      ],
      "default": "aguardando"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "total_records": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "file_name",
    "file_type",
    "imported_by"
  ]
}