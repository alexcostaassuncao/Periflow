{
  "name": "CRMMeta",
  "type": "object",
  "properties": {
    "mes_referencia": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "meta_prospeccao": {
      "type": "number",
      "default": 50,
      "description": "Meta de prospec\u00e7\u00f5es no m\u00eas"
    },
    "meta_reunioes": {
      "type": "number",
      "default": 50,
      "description": "Meta de reuni\u00f5es no m\u00eas"
    },
    "meta_fechamentos": {
      "type": "number",
      "default": 10,
      "description": "Meta de fechamentos no m\u00eas"
    }
  },
  "required": [
    "mes_referencia"
  ]
}