{
  "name": "Publication",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "post_form_id": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "instagram",
              "facebook",
              "linkedin",
              "google_meu_negocio",
              "twitter",
              "tiktok"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "publicar_agora",
              "agendar"
            ]
          },
          "scheduled_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "agendado",
              "publicado",
              "erro",
              "cancelado"
            ],
            "default": "agendado"
          },
          "platform_post_id": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "published_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "agendado",
        "publicado",
        "erro"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "task_id",
    "channels",
    "published_by"
  ]
}