{
  "name": "Expense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "software",
        "trafego",
        "servico",
        "estrutura",
        "pessoal",
        "marketing",
        "outros"
      ]
    },
    "cost_center": {
      "type": "string"
    },
    "expense_type": {
      "type": "string",
      "enum": [
        "fixa",
        "variavel"
      ]
    },
    "value": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "transferencia",
        "cartao",
        "boleto"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "pontual",
        "mensal",
        "trimestral",
        "anual"
      ]
    },
    "supplier_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "atrasado"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "name",
    "value",
    "due_date"
  ]
}