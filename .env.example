# Modelo das variáveis do Periflow.
# Na Vercel: Settings → Environment Variables. No computador: copie para .env.local.
# Nunca coloque valores reais neste arquivo (ele vai para o GitHub).

# Endereço público do site, sem barra no final (ex.: https://periflow.vercel.app)
SITE_URL=

# Banco Turso (turso.tech). Sem isso, o desenvolvimento local usa o arquivo periflow-local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Login do administrador principal (entra como o perfil "Adm"). Senha com 8+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chave que assina as sessões de login: texto aleatório com 32+ caracteres.
SESSION_SECRET=

# Chave do agendador de publicações (texto aleatório com 16+ caracteres; a mesma no GitHub Actions)
CRON_SECRET=

# Cloudinary (imagens e vídeos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instagram (app da Meta)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_TOKEN_KEY=

# Envio de email (opcional)
RESEND_API_KEY=
EMAIL_FROM=
